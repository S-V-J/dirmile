# Weather Forecast
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_SECONDS=15
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_MAX_BATCH_COORDINATES=1000

# Trip plan service
PLAN_MAX_HEATMAP_POINTS=500
PLAN_HEATMAP_HOURS=49
PLAN_WEATHER_BUFFER_HOURS=2
PLAN_MAX_CHECKPOINTS_PER_ROUTE=1000
